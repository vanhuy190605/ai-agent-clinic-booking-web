PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clinic_ai_agent

JWT_SECRET=replace_with_a_random_secret_at_least_32_chars
SEED_DEMO_DATA=true

# Quy định nội bộ mẫu: nghỉ có kế hoạch phải gửi trước bao nhiêu ngày.
PLANNED_LEAVE_NOTICE_DAYS=3

# Optional Gemini API key. Leave blank to use demo fallback AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Forgot password email. For Gmail, use an App Password, not your normal password.
EMAIL_DRY_RUN=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
